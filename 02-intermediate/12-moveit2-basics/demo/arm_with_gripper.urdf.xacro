<?xml version="1.0"?>
<!--
  arm_with_gripper.urdf.xacro: extends Chapter 5's simple_arm.urdf.xacro
  (base_link -> joint1 -> link1 -> joint2 -> link2) with a third joint
  and a simple fixed 2-finger gripper, for a more MoveIt2-realistic
  example (a 2-joint arm has too little freedom to usefully demonstrate
  IK/planning around a target pose).

  Chain: base_link, joint1 (Z) -> link1, joint2 (Y) -> link2,
  joint3 (Y) -> link3, gripper_joint (fixed) -> gripper.
-->
<robot name="arm_with_gripper" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="link1_length" value="0.3"/>
  <xacro:property name="link2_length" value="0.25"/>
  <xacro:property name="link3_length" value="0.15"/>
  <xacro:property name="link_radius" value="0.03"/>
  <xacro:property name="link_mass" value="0.5"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*2} ${link_radius*2} ${link1_length}"/></geometry>
      <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*2} ${link_radius*2} ${link1_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <mass value="${link_mass}"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*2} ${link_radius*2} ${link2_length}"/></geometry>
      <material name="green"><color rgba="0.2 0.8 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*2} ${link_radius*2} ${link2_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <mass value="${link_mass * 0.7}"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- New in this chapter: a third joint (wrist pitch), giving the arm
       enough degrees of freedom for a target pose to usually be
       reachable with a choice of elbow configurations (see DEEP_DIVE.md
       on IK having multiple solutions). -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*1.5} ${link_radius*1.5} ${link3_length}"/></geometry>
      <material name="yellow"><color rgba="0.8 0.8 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <geometry><box size="${link_radius*1.5} ${link_radius*1.5} ${link3_length}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <mass value="${link_mass * 0.4}"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- Gripper: a single fixed link representing a closed 2-finger
       gripper (simplified — a real gripper would have its own
       prismatic/revolute finger joints, out of scope for this basics
       chapter, which is about arm planning, not grasping mechanics). -->
  <link name="gripper">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.04 0.08 0.08"/></geometry>
      <material name="dark_gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.04 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_joint" type="fixed">
    <parent link="link3"/>
    <child link="gripper"/>
    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
  </joint>

</robot>
